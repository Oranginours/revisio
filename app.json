{
  "expo": {
    "name": "Révisio",
    "slug": "revisions",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.mesrevisions.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "com.android.alarm.permission.SET_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "L'appli a besoin de l'appareil photo pour prendre tes cours en photo et scanner le QR code Pronote."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'appli a besoin de tes photos pour lire tes cours.",
          "cameraPermission": "L'appli a besoin de l'appareil photo pour prendre tes cours en photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F7F7F4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#10151d"
          }
        }
      ],
      "expo-sharing"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "79cb6953-c546-46bf-8139-9d3d43f38db7"
      }
    },
    "owner": "oranginours",
    "updates": {
      "url": "https://u.expo.dev/79cb6953-c546-46bf-8139-9d3d43f38db7"
    },
    "ios": {},
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Révisio",
      "shortName": "Révisio",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F4F4F8",
      "lang": "fr"
    },
    "experiments": {
      "baseUrl": "/revisio"
    }
  }
}
