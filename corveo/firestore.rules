rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin de l'appli : le compte « gael »
    function isAdmin() { return signedIn() && request.auth.token.email == 'gael@corveo-famille.app'; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function inFamily(fid) { return signedIn() && me().familyId == fid; }
    function isParent(fid) { return inFamily(fid) && me().role == 'parent'; }
    function ownerOf(fid) { return get(/databases/$(database)/documents/families/$(fid)).data.owner; }
    function sameBan() { return request.resource.data.get('banned', false) == resource.data.get('banned', false); }

    // Profils : chacun modifie le sien ; un parent modifie les membres de sa famille ; l'admin modifie tout.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if (signedIn() && request.auth.uid == uid
        && request.resource.data.role == '' && request.resource.data.familyId == '')
        // profil sans téléphone créé par un parent de la famille
        || (request.resource.data.get('managed', false) == true && request.resource.data.role == 'enfant'
            && isParent(request.resource.data.familyId));
      allow update: if isAdmin() || (signedIn() && sameBan() && (
        (request.auth.uid == uid && (
          request.resource.data.role == resource.data.role
          || request.resource.data.role in ['', 'enfant']
          || (request.resource.data.role == 'parent' && ownerOf(request.resource.data.familyId) == uid)
        ))
        || isParent(resource.data.familyId)
      ));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid)
        || (resource.data.get('managed', false) == true && isParent(resource.data.familyId));
    }

    // Codes pour rejoindre une famille
    match /codes/{code} {
      allow read, create: if signedIn();
      allow delete: if isAdmin() || isParent(resource.data.familyId);
    }

    match /families/{fid} {
      allow read: if isAdmin() || inFamily(fid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || isParent(fid);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);

      match /tasks/{tid} {
        allow read: if isAdmin() || inFamily(fid);
        allow write: if isAdmin() || isParent(fid);
      }
      match /weeks/{wk} {
        allow read, create, update: if isAdmin() || inFamily(fid);
        allow delete: if isAdmin() || isParent(fid);
      }
    }
      // ===== Révisio : classes (cours partagés + notes entre élèves) =====
    function inClass(cid) { return signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid)); }
    match /classCodes/{code} {
      allow read, create: if signedIn();
    }
    match /classes/{cid} {
      allow read: if isAdmin() || inClass(cid);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid;
      match /members/{uid} {
        allow read: if inClass(cid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/classes/$(cid)).data.owner == request.auth.uid);
      }
      match /chapters/{k} {
        allow read: if inClass(cid);
        allow create: if inClass(cid) && request.resource.data.by == request.auth.uid;
        allow update, delete: if inClass(cid) && resource.data.by == request.auth.uid;
        match /notes/{n} {
          allow read: if inClass(cid);
          allow create: if inClass(cid) && request.resource.data.by == request.auth.uid;
          allow delete: if inClass(cid) && resource.data.by == request.auth.uid;
        }
      }
    }
  }
}
