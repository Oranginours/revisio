{
  "expo": {
    "name": "Corvéo",
    "slug": "corveo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "oranginours",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.corveo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1420"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notif-icon.png",
          "color": "#44D62C"
        }
      ]
    ],
    "ios": {},
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Corvéo",
      "shortName": "Corvéo",
      "themeColor": "#0F1420",
      "backgroundColor": "#0F1420",
      "lang": "fr"
    },
    "experiments": {
      "baseUrl": "/revisio/corveo"
    },
    "extra": {
      "eas": {
        "projectId": "0ce1d260-34d7-4486-a08b-ca3eade5c313"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0ce1d260-34d7-4486-a08b-ca3eade5c313"
    }
  }
}
